# BasketPilot environment template.
#
# Copy to .env and fill in real values:
#     cp .env.example .env
#
# .env is gitignored. Never commit real keys.

# Required for the TinyFish engine (Engine A).
# Create one at https://agent.tinyfish.ai/api-keys — new accounts include $8 of free credit,
# which is far more than this POC needs. Keys look like: sk-tinyfish-...
TINYFISH_API_KEY=

# Optional. Overrides the TinyFish API base URL. Leave unset unless you have a reason.
# TINYFISH_BASE_URL=https://agent.tinyfish.ai

# Optional. CloakBrowser runs keyless on its free v146 binary and needs no key.
# Setting a free GitHub key upgrades to the v154 binary (still 1 concurrent session).
# CLOAKBROWSER_LICENSE_KEY=

# ---------------------------------------------------------------------------
# Phase 2 additions
# ---------------------------------------------------------------------------

# The parent agent's LLM tier. Optional: the pipeline is deterministic-first, and
# every part of it — list parsing, product matching, the basket optimizer, the
# explanation — runs without this key. Setting it adds the LLM tier on top
# (messy-list parsing, ambiguous match resolution), it does not replace anything.
#
# Fireworks AI, not Anthropic: this project uses the OpenAI-compatible endpoint at
# https://api.fireworks.ai/inference/v1/chat/completions. Get a key at
# https://fireworks.ai/account/api-keys — keys look like: fw_...
FIREWORKS_API_KEY=

# Optional. Which Fireworks model the LLM tier calls. Must be a model the key can
# reach; the default below is a small instruct model, chosen because the agent's
# LLM work is parsing and phrasing, not reasoning.
# FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct
