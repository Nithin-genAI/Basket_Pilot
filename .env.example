# BasketPilot environment template.
#
# Copy to .env and fill in real values:
#     cp .env.example .env
#
# .env is gitignored. Never commit real keys.

# Required for the TinyFish engine (Engine A).
# Create one at https://agent.tinyfish.ai/api-keys — new accounts include $8 of free credit,
# which is far more than this POC needs. Keys look like: sk-tinyfish-...
TINYFISH_API_KEY=

# Optional. Overrides the TinyFish API base URL. Leave unset unless you have a reason.
# TINYFISH_BASE_URL=https://agent.tinyfish.ai

# Optional. CloakBrowser runs keyless on its free v146 binary and needs no key.
# Setting a free GitHub key upgrades to the v154 binary (still 1 concurrent session).
# CLOAKBROWSER_LICENSE_KEY=
